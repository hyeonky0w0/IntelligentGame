  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB2F9\uC2E0\uC740 \uC774 \uBC15\uBB3C\uAD00\uC758 \uC57C\uAC04 \uACBD\uBE44\uC6D0\uC785\uB2C8\uB2E4.
    \n\uB9E4\uC77C \uBC24 \uBC18\uBCF5\uB418\uB294 \uC9C0\uB8E8\uD55C \uC21C\uCC30\uC774\uC9C0\uB9CC,
    \uC624\uB298 \uBC24\uC740 \uC5B4\uB518\uC9C0 \uBAA8\uB974\uAC8C \uACF5\uAE30\uAC00\n\uBB34\uAC81\uC2B5\uB2C8\uB2E4.\n\n\uC21C\uCC30
    \uAD6C\uC5ED\uC778 '\uC81C2\uC804\uC2DC\uC2E4'. \uADF8 \uBB38\uC744 \uC5F4\uBA74
    \uB300\uCCB4 \uC5B4\uB5A4 \uC2E0\uBE44\uB86D\uACE0 \uAE30\uBB18\uD55C \uC77C\uB4E4\uC774
    \uB2F9\uC2E0\uC744 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAE4C\uC694? \n\n\u25A0
    \uC0DD\uC874 \uBC0F \uD0D0\uC0AC \uAC00\uC774\uB4DC\n- \uBCF5\uB3C4\uB97C \uAC78\uC5B4
    \uB2E4\uB2D0 \uB54C\uB294 <color=#ff0> W, A, S, D \uD0A4 </color>\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n-
    \uD654\uBA74\uC744 \uB3CC\uB824 \uC0AC\uBC29\uC744 \uACBD\uACC4\uD558\uB824\uBA74
    <color=#ff0>\uB9C8\uC6B0\uC2A4</color>\uB97C \uC6C0\uC9C1\uC774\uACE0, \n   \uB2E8\uC11C\uAC00
    \uB420 \uB9CC\uD55C \uBB34\uC5B8\uAC00\uB97C \uBC1C\uACAC\uD558\uBA74 <color=#ff0>\uD074\uB9AD</color>\uD558\uC5EC
    \uD655\uC778\uD558\uC138\uC694.\n- \uC190\uC804\uB4F1\uC740 <color=#ff0> F \uD0A4
    </color>\uB85C \uD0A4\uACE0 \uB04C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n"

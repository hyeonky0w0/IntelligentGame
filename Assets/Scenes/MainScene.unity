  dialogueLines:
  - speakerName: "\uAE08\uB3D9 \uBC18\uAC00\uC0AC\uC720\uC0C1 1"
    line: "\u2026\uC624\uB79C \uCE68\uBB35\uC774 \uAE68\uC9C0\uB294\uAD6C\uB098."
  - speakerName: "\uAE08\uB3D9 \uBC18\uAC00\uC0AC\uC720\uC0C1 2"
    line: "\uC774 \uBC24, \uC774\uACF3\uAE4C\uC9C0 \uBC1C\uC744 \uB4E4\uC778 \uC790\uAC00
      \uC788\uC744 \uC904\uC774\uC57C."
  - speakerName: "\uAE08\uB3D9 \uBC18\uAC00\uC0AC\uC720\uC0C1 2"
    line: "\uB098\uAC00\uACE0 \uC2F6\uC740\uAC00. \uADF8\uB807\uB2E4\uBA74\u2026
      \uC6B0\uB9AC\uB97C \uD1B5\uACFC\uD574\uC57C \uD55C\uB2E4."
  - speakerName: "\uAE08\uB3D9 \uBC18\uAC00\uC0AC\uC720\uC0C1 1"
    line: "\uBC88\uB1CC\uB97C \uD53C\uD558\uACE0 \uAE68\uB2EC\uC74C\uC744 \uBAA8\uC544\uB77C.
